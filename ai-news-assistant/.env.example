# ===== AI 信息搜索助手 配置模板 =====
# 复制为 .env 后填写：cp .env.example .env

# 必填：LLM API Key（DeepSeek 或任意 OpenAI 兼容服务）
DEEPSEEK_API_KEY=sk-你的Key

# 可选（均有默认值）
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=60
# PORT=8080

# 权限验证：配置后所有页面/API 需先登录（不配置则完全开放）
# ACCESS_PASSWORD=请设置一个访问密码
# SECRET_KEY=请设置一个随机字符串（session 签名密钥，生产环境务必修改）
